{
    "name": "gsteel/template-string",
    "description": "A small library for parsing and rendering nested models into string literals using a familiar mustache/handlebars format without additional features",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "email@example.com"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-mbstring": "*",
        "php-standard-library/vec": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "GSteel\\TemplateString\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "carthage-software/mago": "^1.48"
    },
    "autoload-dev": {
        "psr-4": {
            "GSteel\\TemplateStringTest\\": "test/"
        }
    }
}
