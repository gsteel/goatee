{
    "name": "gsteel/goatee",
    "description": "A small library for parsing and rendering nested models into string literals using a familiar mustache/handlebars format without additional features",
    "type": "library",
    "license": "MIT",
    "keywords": ["template", "mustache", "handlebars", "php"],
    "homepage": "https://github.com/gsteel/goatee",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@netglue.uk"
        }
    ],
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-mbstring": "*",
        "php-standard-library/vec": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "GSteel\\Goatee\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3.3",
        "carthage-software/mago": "^1.48"
    },
    "autoload-dev": {
        "psr-4": {
            "GSteel\\GoateeTest\\": "test/"
        }
    }
}
